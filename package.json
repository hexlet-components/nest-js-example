{
  "name": "nest-js-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "db:migrate": "pnpm run build && node dist/migrate.js",
    "db:migrate:test": "pnpm run build && node dist/migrate.js --test",
    "db:seed-owner": "node --env-file-if-exists=.env dist/seed-owner.js",
    "dev": "nest start --watch",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt ."
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-node": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "dotenv": "18.0.10"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "@nestjs/testing": "12.5.1",
    "@nestjs/cli": "12.0.13"
  },
  "description": "NestJS REST API for projects and tasks",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  }
}
